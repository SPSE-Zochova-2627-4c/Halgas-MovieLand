# Local environment values for development - DO NOT COMMIT this file to git.
# Replace the placeholders below with your real secrets before running the app.

# Get your free TMDB API key at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Flask session secret — any long random string works (see SETUP.md for how to generate one)
APP_SECRET=replace_with_a_long_random_secret
-e 
# Get your free OpenRouter API key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
